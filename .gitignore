venv/

# Windows/WSL metadata artifacts -- these get created automatically when
# a file is downloaded on Windows and viewed from WSL. They contain a
# literal colon in the filename (e.g. "main.css:Zone.Identifier"), which
# NTFS/native Windows checkouts (e.g. GitHub Desktop) cannot check out at
# all -- "invalid path" / "unable to checkout working tree" errors.
*:Zone.Identifier
__pycache__/
*.pyc

# Stray local artifacts that have snuck into commits before -- a full
# zipped snapshot of the repo (7-8-26-938.zip, included compiled .pyc
# files) and a patch file whose changes were already merged as a real
# commit (team_ui_changes.diff). Neither belongs in version control;
# .diff/.patch files especially are meant to be applied and discarded,
# not committed alongside the commit they produced.
*.zip
*.diff
*.patch

